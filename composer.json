{
    "name": "maks/todo",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10",
        "friendsofphp/php-cs-fixer": "^3.92"
    },
    "require": {
        "catfan/medoo": "^2.2",
        "slim/psr7": "^1.8",
        "psr/http-message": "^2.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "php-cs-lint": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes --dry-run --diff",
        "php-cs-fixer": "php-cs-fixer fix --config=.php-cs-fixer.php --allow-risky=yes"
    }
}
